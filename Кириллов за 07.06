import tkinter as tk
import random

root = tk.Tk()
root.title("Random Joke Generator")
root.geometry("400x200")

jokes = [
    "Встречаются два программиста. Один говорит: «Вчера жену в кино повёл». Второй: «А какой фильм?» «.avi» — отвечает первый.",
    "Сисадмин открывает холодильник и видит надпись: «Не пинать!» Он закрывает, думает, снова открывает — там же. «Этот холодильник явно работает под Linux», — вздыхает он.",
    "Мама просит сына-айтишника: «Сынок, настрой мне телевизор, а то там каналы сбились». Сын: «Мама, скажи, что хочешь сделать». Мама: «Посмотреть новости». Сын: «Тогда зачем тебе 55-й канал?»",
    "Как называют программиста, который не умеет работать с Git? — Самоделкин.",
    "Зачем программисту очки? Чтобы видеть баги."
]

def show_joke():
    current_joke = random.choice(jokes)
    joke_label.config(text=current_joke)

joke_label = tk.Label(root, text="Нажми на кнопку!", wraplength=380)
joke_label.pack(pady=20)

button = tk.Button(root, text="Получить анекдот", command=show_joke)
button.pack(pady=10)

root.mainloop()
